{
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Yarp": "Information"
      }
    }
  },
  "Jwt": {
    "Issuer": "devhub-auth",
    "Audience": "devhub-platform"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/users/{**catch-all}" }
      },
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/aggregator/{**catch-all}" }
      },
      "pipelines": {
        "ClusterId": "cicd",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/pipelines/{**catch-all}" }
      },
      "build-runs": {
        "ClusterId": "cicd",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/build-runs/{**catch-all}" }
      },
      "agents": {
        "ClusterId": "cicd",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/agents/{**catch-all}" }
      },
      "packages": {
        "ClusterId": "registry",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/packages/{**catch-all}" }
      },
      "tags": {
        "ClusterId": "registry",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/tags/{**catch-all}" }
      },
      "discussions": {
        "ClusterId": "telemetry",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/discussions/{**catch-all}" }
      },
      "crash-reports": {
        "ClusterId": "telemetry",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/crash-reports/{**catch-all}" }
      },
      "secrets": {
        "ClusterId": "secrets",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/secrets/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "d1": { "Address": "http://auth-api" } }
      },
      "aggregator": {
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "cicd": {
        "Destinations": { "d1": { "Address": "http://cicd-api" } }
      },
      "registry": {
        "Destinations": { "d1": { "Address": "http://registry-api" } }
      },
      "telemetry": {
        "Destinations": { "d1": { "Address": "http://telemetry-api" } }
      },
      "secrets": {
        "Destinations": { "d1": { "Address": "http://secrets-api" } }
      }
    }
  },
  "AllowedHosts": "*"
}
